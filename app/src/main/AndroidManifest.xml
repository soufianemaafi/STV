<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".STVApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        tools:targetApi="31">

        <!-- AdMob App ID (résolu dynamiquement via manifestPlaceholders dans build.gradle.kts) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}"/>

        <activity
            android:name=".features.home.presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowLightStatusBar="false"
            android:theme="@style/Theme.STV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".features.player.presentation.PlayerActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:supportsPictureInPicture="true"
            android:windowLightStatusBar="false"
            android:theme="@style/Theme.STV">

            <!--
                ⚠️ SÉCURITÉ (Intent Hijacking / Intent Redirection) :
                Ces intent-filters ne font que ROUTER l'intent vers PlayerActivity.
                Ils n'accordent AUCUNE confiance au contenu (extras/data). Toute URL
                est systématiquement revalidée au runtime par
                `com.example.stv.core.security.IntentSecurityManager` (schéma
                http/https strict) avant d'être transmise au ViewModel — voir
                PlayerActivity.handleIncomingIntent().

                Note App Links : `android:autoVerify="true"` n'est utile que pour un
                schéma https adossé à un `assetlinks.json` hébergé sur un domaine que
                nous possédons. Notre app ne dispose pas d'un tel domaine associé ;
                l'activer sans assetlinks.json n'apporterait aucune vérification
                réelle. À activer si un App Link officiel (https://stv.example.com/...)
                est mis en place.
            -->

            <!-- Intent Filter 1 : Action personnalisée pour SoukiTV et vos apps catalogue -->
            <intent-filter>
                <action android:name="com.example.stv.action.PLAY_STREAM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Intent Filter 2 : Deep Link interne (stv://play?url=...) — schéma privé, non vérifiable via App Links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="stv"
                    android:host="play" />
            </intent-filter>

            <!-- Intent Filter 3 : Fichiers vidéo HLS/DASH (comme VLC, MX Player) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/x-mpegurl" />
            </intent-filter>

            <!-- Intent Filter 4 : Tous types de vidéo (schéma restreint à http/https uniquement) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>