<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".STVApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        tools:targetApi="31">

        <!-- AdMob App ID (résolu dynamiquement via manifestPlaceholders dans build.gradle.kts) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Écran d'accueil / Launcher -->
        <activity
            android:name=".features.home.presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.STV"
            android:windowLightStatusBar="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lecteur Vidéo Principal (Strictement Paysage & Immersif) -->
        <activity
            android:name=".features.player.presentation.PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.STV"
            android:windowLightStatusBar="false">

            <!--
                ⚠️ SÉCURITÉ (Intent Hijacking / Intent Redirection) :
                Ces intent-filters ne font que ROUTER l'intent vers PlayerActivity.
                Toute URL est systématiquement revalidée au runtime par
                `com.example.stv.core.security.IntentSecurityManager` (schéma
                http/https strict) avant d'être transmise au ViewModel.
            -->

            <!-- 1. Action personnalisée exclusive (Recommandée pour SoukiTV) -->
            <intent-filter>
                <action android:name="com.example.stv.action.PLAY_STREAM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- 2. Deep Link personnalisé privé (ex: stv://play?url=...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="play"
                    android:scheme="stv" />
            </intent-filter>

            <!-- 3. Tous types MIME Vidéo & Streaming (HLS + DASH + MP4/MKV) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/x-mpegurl" />
                <data android:mimeType="application/dash+xml" />
            </intent-filter>

            <!-- 4. Détection par extension de fichier (si l'app émettrice n'a pas spécifié de MIME-type) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" android:host="*" />
                <data android:scheme="https" android:host="*" />
                <data android:pathPattern=".*\\.m3u8" />
                <data android:pathPattern=".*\\.mpd" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.mkv" />
            </intent-filter>
        </activity>

    </application>

</manifest>